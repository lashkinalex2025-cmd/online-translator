{
  "name": "online-translator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:capacitor": "tsc -b && vite build --mode capacitor",
    "lint": "oxlint",
    "preview": "vite preview",
